# No environment file is required for zero-key local mode.
PORT=4000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Optional PostgreSQL mode (run migration before starting API)
# DATABASE_URL=postgresql://moa:moa_local_only@localhost:5432/moa
# REDIS_URL=redis://localhost:6379
# Optional OCR + visual product recognition. Keep this server-side only.
# OPENAI_API_KEY=your-server-api-key
# OPENAI_VISION_MODEL=gpt-4.1-mini
# Link product text -> Korean. Uses OPENAI_API_KEY; optional model override.
# OPENAI_TRANSLATION_MODEL=gpt-4.1-mini
# Domestic meetup place search (server-side secret, never EXPO_PUBLIC).
# KAKAO_REST_API_KEY=your-kakao-local-rest-api-key
# Social login. Register the three callback URLs shown in README, and keep every secret server-side.
# OAUTH_CALLBACK_BASE_URL=http://localhost:8081
# GOOGLE_CLIENT_ID=your-google-web-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# KAKAO_LOGIN_REST_API_KEY=your-kakao-login-rest-api-key
# KAKAO_LOGIN_CLIENT_SECRET=your-optional-kakao-client-secret
# NAVER_CLIENT_ID=your-naver-client-id
# NAVER_CLIENT_SECRET=your-naver-client-secret
# Optional storage adapter configuration; UI currently uses local demo image data.
# AWS_REGION=ap-northeast-2
# S3_BUCKET=your-private-bucket
# Do not put AWS secrets into mobile environment variables.
