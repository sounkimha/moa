# Browser/iOS simulator defaults to localhost; Android emulator uses 10.0.2.2.
# Set this to your computer's LAN IP to test from a physical phone.
# EXPO_PUBLIC_API_URL=http://192.168.0.10:4000

# Google Maps JavaScript API key. Restrict this key to the app's web origins.
# Without it, the app still shows a real single-place Google Maps embed.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
