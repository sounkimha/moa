# Expo Go/native defaults to the deployed demo API. Set this to your computer's
# LAN IP only when you intentionally run the API locally on a physical phone.
# EXPO_PUBLIC_API_URL=http://192.168.0.10:4000

# Kakao Developers > App > Platform Key > Native app key.
# Register iOS bundle ID and Android package as com.moa.prototype.
# The native build generates the kakao${KAKAO_NATIVE_APP_KEY}://oauth redirect scheme.
# Used only by the native Expo config plugin; never commit the real value.
KAKAO_NATIVE_APP_KEY=your_kakao_native_app_key

# Kakao Developers > App > Platform Key > JavaScript key.
# Used by the direct-deal map on web and inside the native WebView.
# Restrict it to localhost/Codespaces/deployed web domains in Kakao Developers.
EXPO_PUBLIC_KAKAO_MAPS_JS_KEY=your_kakao_javascript_key

# Google Cloud Console > APIs & Services > Credentials.
# Create a separately restricted key for each target instead of reusing one key.
# Web key: restrict by HTTP referrer. It is exposed in the JavaScript bundle.
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=your_google_maps_web_api_key
# Android key: restrict to package com.moa.prototype and the app signing SHA-1.
GOOGLE_MAPS_ANDROID_API_KEY=your_google_maps_android_api_key
# iOS key: restrict to bundle ID com.moa.prototype.
GOOGLE_MAPS_IOS_API_KEY=your_google_maps_ios_api_key
