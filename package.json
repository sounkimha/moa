{
  "name": "moa-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:mobile": "node scripts/dev.mjs",
    "dev:api": "npm run dev -w @moa/api",
    "dev:admin": "npm run dev -w @moa/admin",
    "admin:setup": "node scripts/admin-setup.mjs",
    "build": "npm run build -w @moa/domain && npm run build -w @moa/api && npm run export -w @moa/mobile && npm run build -w @moa/admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run build -w @moa/domain && npm run test -w @moa/api",
    "test:ui": "npm run build -w @moa/domain && npm run build -w @moa/api && npm run export -w @moa/mobile && node scripts/ui-smoke.mjs",
    "test:browser": "npm run build && python3 scripts/browser-audit.py",
    "test:redesign": "npm run build && python3 scripts/redesign-audit.py",
    "test-data:reset": "npm run build -w @moa/domain && npm run build -w @moa/api && node scripts/reset-test-data.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "reset": "node scripts/reset.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9.39.5",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.2"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
